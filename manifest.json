{
  "manifest_version": 2,
  "name": "code-server Discord Presence",
  "version": "0.1.2",
  "description": "Publishes privacy-aware code-server activity to Discord without native software.",
  "icons": {
    "16": "assets/icons/extension-16.png",
    "32": "assets/icons/extension-32.png",
    "48": "assets/icons/extension-48.png",
    "96": "assets/icons/extension-96.png",
    "128": "assets/icons/extension-128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "identity",
    "storage",
    "tabs",
    "https://discord.com/api/*",
    "https://discord.com/oauth2/*"
  ],
  "optional_permissions": ["<all_urls>"],
  "background": {
    "scripts": [
      "src/shared/browser-compat.js",
      "src/shared/language-names.js",
      "src/shared/presence.js",
      "src/shared/oauth.js",
      "src/background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "code-server Discord Presence",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icons/extension-16.png",
      "32": "assets/icons/extension-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "code-server-discord-presence@me0wzz.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteActivity", "websiteContent"]
      }
    }
  }
}
